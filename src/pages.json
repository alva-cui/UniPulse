{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },

  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "多端应用"
      }
    },
    {
      "path": "pages/pinia/index",
      "style": {
        "navigationBarTitleText": "Pinia"
      }
    },
    {
      "path": "pages/chart/index",
      "style": {
        "navigationBarTitleText": "Chart"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "多端应用",
    "navigationBarBackgroundColor": "#F0F4FF",
    "backgroundColor": "#F7F8FA"
  }
}
