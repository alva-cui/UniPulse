{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": true,
    "lib": ["esnext", "dom"],

    // 1. 扩充类型声明（加入微信小程序类型和 uni-helper 类型）
    "types": ["@dcloudio/types", "@uni-helper/uni-app-types", "@wot-ui/ui/global"],

    // 2. 忽略第三方声明文件的类型检查（防止各种外部库冲突导致打包失败）
    "skipLibCheck": true,

    // 3. 开启 isolatedModules 校验（Vite 使用 esbuild 编译单文件，必须开启此项以防语法不兼容）
    "isolatedModules": true,

    // 4. 允许在代码中 import 导入 .json 文件（比如读取 pages.json 或 package.json）
    "resolveJsonModule": true,

    // 5. 告知 TS 只做类型检查，不输出任何 JS 文件（因为编译输出是由 Vite 负责的）
    "noEmit": true
  },

  // 6. 配置 Volar 插件，让编辑器对组件提供精准的类型补全
  "vueCompilerOptions": {
    "plugins": ["@uni-helper/uni-app-types/volar-plugin"]
  },

  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}
