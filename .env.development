# 应用标题
VITE_APP_TITLE=多端应用（uni-app）

# 真实后端地址（小程序 / App 直接请求；H5 开发代理目标）
# 真机调试改为电脑局域网 IP，如 http://192.168.1.8:8080
VITE_APP_API_BASE_URL=http://127.0.0.1:8080

# H5 请求前缀（开发走 Vite 代理；生产由 Nginx 反代）
VITE_APP_BASE_API=/dev-api

# H5 开发服务（CONTEXT_PATH 需与 src/manifest.json → h5.router.base 保持一致）
VITE_APP_PORT=9527
VITE_APP_CONTEXT_PATH=/h5/

# 环境标识（展示/埋点用，与 Vite MODE 独立）
VITE_APP_ENV=development
